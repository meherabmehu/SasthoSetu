# Application
APP_NAME=SasthoSetu API
APP_VERSION=1.0.0
# development | test | staging | production
APP_ENV=development
APP_DEBUG=false

# Database
# Defaults to SQLite so a fresh checkout runs with no database server to
# install. Switch to PostgreSQL for staging and production.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sasthosetu

# Authentication
# Must be at least 32 characters in staging and production, where the
# application refuses to start with the development default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# HTTP
# Comma-separated allowed origins. "*" disables credentialed CORS.
# Includes the common local static-server ports so the frontend can call the
# API during development without extra configuration. Narrow this to your real
# domain in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080
RATE_LIMIT_PER_MINUTE=120

# Language model for symptom understanding (optional).
# Leave LLM_API_KEY blank and the platform runs on its deterministic rules
# alone - every feature still works, the lexicon just understands fewer
# colloquial phrasings. The model is only ever used to map free text onto the
# existing symptom vocabulary; it never decides urgency, condition or advice.
# Works with any OpenAI-compatible endpoint, including a local Ollama or vLLM
# server.
# Defaults target Groq, which has a free tier with no credit card.
# Get a key at https://console.groq.com  -  see docs/LLM_SETUP.md
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant

# Commercial
# Share of each transaction retained by the platform (0.02 = 2%).
PLATFORM_COMMISSION_RATE=0.02

# Payment gateways.
# Left blank the adapters run in sandbox mode and label their responses as
# such, rather than implying a real charge was made.
BKASH_API_KEY=
BKASH_API_SECRET=
NAGAD_API_KEY=
NAGAD_API_SECRET=
ROCKET_API_KEY=
ROCKET_API_SECRET=
SSLCOMMERZ_API_KEY=
SSLCOMMERZ_API_SECRET=

# Docker compose only
POSTGRES_DB=sasthosetu
POSTGRES_USER=sasthosetu
POSTGRES_PASSWORD=replace-with-a-strong-password
WEB_PORT=8080
WEB_CONCURRENCY=4
SEED_ON_START=true
