# Application
APP_NAME=SasthoSetu API
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=false

# Database
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sasthosetu

# Authentication
# Generate a long random value before staging or production deployment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
