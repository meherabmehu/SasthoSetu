# The committed seed data and trained models travel with the image so the
# build does not have to spend twenty minutes reproducing them. Everything
# here that is not committed is excluded instead, so a half-finished local
# download or a locally retrained model cannot be shipped by accident.
data/real/_cache
data/real/skin/images
data/real/imaging/dermnet
data/real/imaging/chest_xray
data/real/imaging/mpox
data/real/imaging/tb
data/real/imaging/pad
data/triage
data/surge
data/surveillance
.ruff_cache
.pytest_cache
node_modules

# Static build output, produced per deployment and not used by the image.
frontend/dist
