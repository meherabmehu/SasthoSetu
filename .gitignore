# Python
__pycache__/
*.pyc

# Virtual Environment
venv/
.venv/
backend/venv/
backend/.venv/

# Environment Variables
.env

# VS Code
.vscode/

# Logs
*.log

# Database
*.db

# OS Files
.DS_Store
Thumbs.db

# Databases
*.sqlite3
backend/*.db

# Generated ML datasets (rebuild with ml/prepare_all.py)
data/triage/*.csv
data/surge/*.csv
data/surveillance/*.csv

# Raw downloads. The derived CSVs in data/real/ are committed; the originals
# they were built from are large and re-fetchable with ml/fetch_real_data.py.
data/real/_cache/

# Trained model artifacts (binary, rebuilt by ml/prepare_all.py).
# The exceptions are the five served models: together under 8 MB, and a
# hosted deployment cannot rebuild them at start-up (the imaging ones need
# several GB of source images). They are tracked and refreshed by
# re-running the pipeline in a pinned environment.
backend/app/ai/artifacts/*
!backend/app/ai/artifacts/triage_model.joblib
!backend/app/ai/artifacts/triage_metrics.json
!backend/app/ai/artifacts/triage_confusion.csv
!backend/app/ai/artifacts/surge_model.joblib
!backend/app/ai/artifacts/surge_metrics.json
!backend/app/ai/artifacts/skin_model.joblib
!backend/app/ai/artifacts/skin_metrics.json
!backend/app/ai/artifacts/dermnet_model.joblib
!backend/app/ai/artifacts/dermnet_metrics.json
!backend/app/ai/artifacts/chest_xray_model.joblib
!backend/app/ai/artifacts/chest_xray_metrics.json
!backend/app/ai/artifacts/mpox_model.joblib
!backend/app/ai/artifacts/mpox_metrics.json
!backend/app/ai/artifacts/tb_model.joblib
!backend/app/ai/artifacts/tb_metrics.json

# HAM10000 images: 2.8 GB, CC BY-NC (non-commercial), re-fetchable with
# ml/fetch_skin_data.py. The derived metadata CSV is committed.
data/real/skin/images/

# Extracted medical images (DermNet, chest X-ray): several GB, re-fetchable
# with ml/fetch_medical_datasets.py. The label CSVs are committed.
data/real/imaging/dermnet/
data/real/imaging/chest_xray/
data/real/imaging/mpox/
data/real/imaging/tb/

# Built by scripts/build_frontend.py at deploy time. Committing it would
# freeze one deployment's API address into the repository.
frontend/dist/
